# Docker build context exclusions
# Keep the build context small and avoid sending unnecessary files to the daemon

# Version control
.git/
.gitignore

# Dependencies (installed fresh in Docker)
node_modules/
**/node_modules/

# Build outputs (built inside Docker)
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo

# Test files (not needed in production image)
**/*.test.ts
**/*.spec.ts
coverage/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment files
.env
.env.*
!.env.example

# Documentation (not needed in runtime image)
docs/
README.md

# Logs
*.log

# CI/CD
.github/
