# =============================================================================
# Aegis Environment Configuration
#
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Application Ports ────────────────────────────────────────────────────────
API_PORT=3000
WORKER_PORT=3001

# ── Database (PostgreSQL — Phase 5: Persistent State) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aegis
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Future: Cache (Redis) ────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=aegis:

# ── Future: Event Streaming (Kafka) ──────────────────────────────────────────
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=aegis
# KAFKA_GROUP_ID=aegis-workers

# ── Future: AI Providers ─────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# ANTHROPIC_API_KEY=

# ── Future: Observability ────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=aegis
