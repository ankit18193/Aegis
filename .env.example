# =============================================================================
# Aegis Environment Configuration
#
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to version control.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Application Ports ────────────────────────────────────────────────────────
API_PORT=3000
WORKER_PORT=3001

# ── Database (PostgreSQL — Phase 5: Persistent State) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aegis
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Agent Runtime (Phase 6: Agent Runtime) ──────────────────────────────────
AGENT_MAX_ITERATIONS=10

# ── Future: Cache (Redis) ────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=aegis:

# ── Event Streaming (Kafka — Phase 10A: Event Backbone Foundation) ──────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=aegis-api
KAFKA_EVENTS_TOPIC=aegis.events
KAFKA_CONNECTION_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_INITIAL_DELAY_MS=100
KAFKA_RETRY_MAX_DELAY_MS=1000
# KAFKA_GROUP_ID=aegis-workers # Phase 10B

# ── Future: AI Providers ─────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# ANTHROPIC_API_KEY=

# ── Future: Observability ────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=aegis
